# Server Configuration
PORT=5000

# Application Database Configuration (Development / Production)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/internship_management_db?retryWrites=true&w=majority

# Dedicated Integration Test Database (Required for integration tests; must be 'internship_management_test')
MONGODB_TEST_URI=mongodb+srv://<username>:<password>@<cluster-url>/internship_management_test?retryWrites=true&w=majority
